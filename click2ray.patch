+/**
+ * Click2ray: the big one-tap button (download, replace, test, clean up) and a plain "test" button.
+ *
+ * While a test runs the main button turns into "Cancel". While the download runs it is disabled
+ * and shows a spinner, because that step cannot be cancelled.
+ */
+@Composable
+fun MainUpdateBar(
+    isLoading: Boolean,
+    isTesting: Boolean,
+    onUpdateAndTest: () -> Unit,
+    onCancelTesting: () -> Unit,
+    onTestAll: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier
+            .fillMaxWidth()
+            .padding(horizontal = 12.dp, vertical = 8.dp),
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (isTesting) {
+            Button(
+                onClick = onCancelTesting,
+                modifier = Modifier
+                    .weight(1f)
+                    .heightIn(min = 52.dp),
+                colors = ButtonDefaults.buttonColors(
+                    containerColor = MaterialTheme.colorScheme.errorContainer,
+                    contentColor = MaterialTheme.colorScheme.onErrorContainer,
+                ),
+            ) {
+                CircularProgressIndicator(
+                    modifier = Modifier.size(18.dp),
+                    strokeWidth = 2.dp,
+                    color = LocalContentColor.current,
+                )
+                Spacer(Modifier.width(8.dp))
+                Text(stringResource(R.string.click2ray_cancel_test))
+            }
+        } else {
+            Button(
+                onClick = onUpdateAndTest,
+                enabled = !isLoading,
+                modifier = Modifier
+                    .weight(1f)
+                    .heightIn(min = 52.dp),
+            ) {
+                if (isLoading) {
+                    CircularProgressIndicator(
+                        modifier = Modifier.size(18.dp),
+                        strokeWidth = 2.dp,
+                        color = LocalContentColor.current,
+                    )
+                } else {
+                    Icon(painterResource(R.drawable.ic_refresh_24dp), contentDescription = null)
+                }
+                Spacer(Modifier.width(8.dp))
+                Text(
+                    stringResource(
+                        if (isLoading) R.string.click2ray_updating else R.string.click2ray_update_and_test
+                    )
+                )
+            }
+            OutlinedButton(
+                onClick = onTestAll,
+                enabled = !isLoading,
+                modifier = Modifier.heightIn(min = 52.dp),
+            ) {
+                Text(stringResource(R.string.click2ray_test_all))
+            }
+        }
+    }
+}
+
+/**
+ * Click2ray: asks the user to read and accept the source site's terms before anything is
+ * downloaded. The site treats ticking the box and copying the link as acceptance, so the
+ * accept button stays disabled until the user ticks the box themselves.
+ */
+@Composable
+fun Click2rayTermsDialog(
+    onAccept: () -> Unit,
+    onDismiss: () -> Unit,
+    onOpenTerms: () -> Unit,
+) {
+    var checked by rememberSaveable { mutableStateOf(false) }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.click2ray_terms_title)) },
+        text = {
+            Column(modifier = Modifier.verticalScroll(rememberScrollState())) {
+                Text(
+                    text = stringResource(R.string.click2ray_terms_body),
+                    style = MaterialTheme.typography.bodyMedium,
+                )
+                TextButton(onClick = onOpenTerms) {
+                    Text(stringResource(R.string.click2ray_terms_read))
+                }
+                // One focusable node for the whole row, so the checkbox and its label are not
+                // two separate targets for TalkBack or the D-pad.
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .toggleable(
+                            value = checked,
+                            role = Role.Checkbox,
+                            onValueChange = { checked = it },
+                        )
+                        .padding(vertical = 8.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Checkbox(checked = checked, onCheckedChange = null)
+                    Spacer(Modifier.width(8.dp))
+                    Text(
+                        text = stringResource(R.string.click2ray_terms_accept_label),
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onAccept, enabled = checked) {
+                Text(stringResource(R.string.click2ray_terms_accept_button))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) {
+                Text(stringResource(R.string.click2ray_terms_not_now))
+            }
+        },
+    )
+}
