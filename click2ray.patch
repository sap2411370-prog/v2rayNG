@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Click2ray strings. Only English and Persian are translated; other locales fall back to English. -->
+<resources xmlns:tools="http://schemas.android.com/tools">
+    <string name="click2ray_update_and_test" tools:ignore="MissingTranslation">Update and test configs</string>
+    <string name="click2ray_updating" tools:ignore="MissingTranslation">Updating…</string>
+    <string name="click2ray_test_all" tools:ignore="MissingTranslation">Test</string>
+    <string name="click2ray_cancel_test" tools:ignore="MissingTranslation">Cancel test</string>
+    <string name="click2ray_stop_connection_first" tools:ignore="MissingTranslation">Disconnect first, then update. A test through an active connection gives wrong results.</string>
+    <string name="click2ray_update_failed" tools:ignore="MissingTranslation">Could not download the configs. Check your internet connection and try again.</string>
+    <string name="click2ray_no_working_configs" tools:ignore="MissingTranslation">No config passed the test, so nothing was removed. Check your internet connection and try again.</string>
+    <string name="click2ray_update_done" tools:ignore="MissingTranslation">Done: %1$d working, %2$d removed. The fastest one is selected.</string>
+
+    <string name="click2ray_terms_title" tools:ignore="MissingTranslation">Terms of use</string>
+    <string name="click2ray_terms_body" tools:ignore="MissingTranslation">Click2ray downloads a public list of configurations from sub.vlessfo.ru. That site only collects configurations; it does not own or run the servers. The servers belong to unknown third parties, and nobody guarantees their speed, availability or privacy, so do not use them for banking or other sensitive logins.\n\nClick2ray also adds a second source: a public configuration list on GitHub (Epodonios). The same warning applies to it.\n\nThe site\'s rules say the service must not be used to reach content that is banned by law in Russia or Belarus, and that you are responsible for obeying the law where you live.</string>
+    <string name="click2ray_terms_read" tools:ignore="MissingTranslation">Read the full terms</string>
+    <string name="click2ray_terms_accept_label" tools:ignore="MissingTranslation">I have read and accept the Terms of Use, Public Offer and Privacy Policy.</string>
+    <string name="click2ray_terms_accept_button" tools:ignore="MissingTranslation">Accept and continue</string>
+    <string name="click2ray_terms_not_now" tools:ignore="MissingTranslation">Not now</string>
+
+    <string name="click2ray_about_developer_label" tools:ignore="MissingTranslation">Developed by</string>
+    <string name="click2ray_about_developer_name" translatable="false">کافی نت کلیک نکا</string>
+    <string name="click2ray_about_based_on" tools:ignore="MissingTranslation">Based on v2rayNG (GPLv3)</string>
+</resources>
