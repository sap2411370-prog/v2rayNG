+    /**
+     * Download the built-in subscription (replacing its configs), select it, and start a real-delay
+     * test of every config in it. [finishUpdateAndTest] completes the flow when the test is done.
+     */
+    private fun updateAndTestAll() {
+        val state = uiState.value
+        if (!state.termsAccepted) return
+        if (oneTapJob?.isActive == true || state.isTesting) return
+        if (state.isRunning) {
+            // A test through the active tunnel would measure the tunnel, not the configs.
+            toastError(R.string.click2ray_stop_connection_first)
+            return
+        }
+        oneTapJob = viewModelScope.launch {
+            _isLoading.value = true
+            try {
+                val subId = withContext(ioDispatcher) { refreshDefaultSubscription() }
+                    ?: return@launch
+                dataSource.setSelectedSubscriptionId(subId)
+                _uiState.update { it.copy(selectedGroupId = subId) }
+                setupGroupTab(forceRefresh = true).join()
+                refreshSelectedGuid()
+
+                // Still on the main thread, which owns the test request bookkeeping.
+                testAllRealPing(onlyTcp = false)
+                if (testRequests.isTesting) {
+                    pendingCleanupSubId = subId
+                } else {
+                    toastError(R.string.click2ray_update_failed)
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (e: Exception) {
+                LogUtil.e(AppConfig.TAG, "Update and test failed", e)
+                toastError(R.string.toast_failure)
+            } finally {
+                _isLoading.value = false
+            }
+        }
+    }
